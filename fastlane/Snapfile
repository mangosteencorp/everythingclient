workspace("everythingclient.xcworkspace")
scheme("DemoTests")
only_testing(["DemoTests/ScreenshotTests"])

languages(["en-US"])
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
override_status_bar(true)
concurrent_simulators(false)
skip_open_summary(true)
stop_after_first_error(false)
# The DemoTests scheme is parallelizable; cloning simulators for it is slow and flaky, and screenshots gain nothing from it.
xcargs("-parallel-testing-enabled NO")
